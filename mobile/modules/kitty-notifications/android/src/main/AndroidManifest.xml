<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The morning message (Android 13+ asks the person first) -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Lets Crest show the names of apps that post money alerts (launcher apps only, not every package) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application>
    <service
      android:name="expo.modules.kittynotifications.KittyNotificationListener"
      android:label="Crest payment alerts"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <receiver android:name="expo.modules.kittynotifications.MorningReceiver" android:exported="false" />
  </application>
</manifest>
