<?xml version="1.0" encoding="utf-8"?>
<!-- Crest's widget: today's figure on the home or cover screen. Plain RemoteViews so it updates the moment a payment lands. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/crest_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/crest_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/crest_notify"
            android:tint="#C9A04A"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/crest_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crest"
            android:textColor="#E8D49A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/crest_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="left today"
            android:textColor="#C7CEDA"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/crest_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#8D95A1"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
